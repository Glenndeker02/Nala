  campaignId   String                     @map("campaign_id")
  type         PayoutType
  amount       Decimal                    @db.Decimal(10, 2)
  currency     String                     @default("USD")
  status       PayoutStatus               @default(PENDING)
  reference    String?
  metadata     Json?
  createdAt    DateTime                   @default(now()) @map("created_at")
  paidAt       DateTime?                  @map("paid_at")
  assignment   CreatorCampaignAssignment? @relation(fields: [assignmentId], references: [id])
  campaign     Campaign                   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator      User                       @relation("creator_payouts", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([campaignId])
  @@index([status])
  @@index([type])
  @@map("payouts")
}

model SubscriptionEvent {
  id                 String         @id @default(uuid())
  campaignId         String         @map("campaign_id")
  creatorId          String         @map("creator_id")
  redemptionId       String         @map("redemption_id")
  externalCustomerId String         @map("external_customer_id")
  planPrice          Decimal        @map("plan_price") @db.Decimal(10, 2)
  creatorBonus       Decimal        @map("creator_bonus") @db.Decimal(10, 2)
  platformFee        Decimal        @map("platform_fee") @db.Decimal(10, 2)
  paidAt             DateTime       @map("paid_at")
  platformReceipt    Json?          @map("platform_receipt")
  reconciled         Boolean        @default(false)
  createdAt          DateTime       @default(now()) @map("created_at")
  campaign           Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator            User           @relation("creator_subscriptions", fields: [creatorId], references: [id], onDelete: Cascade)
  redemption         CodeRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([creatorId])
  @@index([reconciled])
  @@map("subscription_events")
}



