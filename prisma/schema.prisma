// Nala Platform Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed with bcrypt
  role      Role     @default(CREATOR)
  fullName  String   @map("full_name")

  // Founder specific
  companyName       String?   @map("company_name")
  stripeCustomerId  String?   @unique @map("stripe_customer_id")

  // Creator specific
  stripeAccountId   String?   @unique @map("stripe_account_id")
  creatorProfile    CreatorProfile?

  // Common fields
  emailVerified     Boolean   @default(false) @map("email_verified")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?   @map("two_factor_secret")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastLoginAt       DateTime? @map("last_login_at")

  // Admin management fields
  suspendedUntil    DateTime? @map("suspended_until")
  suspensionReason  String?   @map("suspension_reason")
  bannedReason      String?   @map("banned_reason")
  founderTier       String?   @map("founder_tier") // SILVER, GOLD, PLATINUM


  // Relations
  campaigns         Campaign[]       @relation("founder_campaigns")
  creatorCampaigns  Campaign[]       @relation("creator_campaigns")
  payments          Payment[]
  licenses          License[]        @relation("founder_licenses")
  creatorLicenses   License[]        @relation("creator_licenses")
  socialAccounts    SocialAccount[]
  socialConnections SocialConnection[] @relation("social_connections")
  applications      Application[]    @relation("creator_applications")
  assignedVideos    Video[]          @relation("creator_videos")
  notifications     Notification[]
  initiatedDisputes Dispute[]        @relation("dispute_initiator")
  respondentDisputes Dispute[]       @relation("dispute_respondent")
  disputeMessages   DisputeMessage[]
  disputeEvidence   DisputeEvidence[]
  adminUser         AdminUser?

  // Trending Formats
  savedFormats      CreatorFormatLibrary[]
  formatRecommendations FormatRecommendation[]

  // Phase 4-6 Relations
  conversationParticipants ConversationParticipant[]
  sentMessages          Message[]
  activities            Activity[]
  assets                Asset[]
  submittedVersions     VideoVersion[]       @relation("SubmittedVersions")
  reviewedVersions      VideoVersion[]       @relation("ReviewedVersions")
  grantedLicenses       License[]            @relation("LicenseGrantee")
  assignedVariants      UGCVariant[]
  
  // Advanced Campaign System
  founderVideos         FounderVideo[]       @relation("founder_videos")

  @@map("users")
}

enum Role {
  FOUNDER
  CREATOR
  ADMIN
}

// ============================================
// CREATOR PROFILE
// ============================================

model CreatorProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio                 String?
  categories          String[]  // e.g., ["SaaS", "B2B", "Tech"]

  // Platform-specific base fees
  baseFeeTiktok       Decimal   @default(75.00) @map("base_fee_tiktok") @db.Decimal(10, 2)
  baseFeeInstagram    Decimal   @default(75.00) @map("base_fee_instagram") @db.Decimal(10, 2)
  baseFeeFacebook     Decimal   @default(75.00) @map("base_fee_facebook") @db.Decimal(10, 2)

  // Portfolio
  portfolioVideos     Json?     @map("portfolio_videos") // Array of {url, thumbnail, platform, title}

  // Status
  verificationStatus  VerificationStatus @default(PENDING) @map("verification_status")
  availabilityStatus  String?   @map("availability_status")
  responseTime        String?   @map("response_time") // e.g., "< 24 hours"
  isOnboardingComplete Boolean  @default(false) @map("is_onboarding_complete")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Admin management
  adminNotes          String?   @map("admin_notes")


  @@map("creator_profiles")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

// ============================================
// SOCIAL MEDIA ACCOUNTS
// ============================================

model SocialAccount {
  id                String     @id @default(uuid())
  creatorId         String     @map("creator_id")
  creator           User       @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform          Platform
  platformUserId    String     @map("platform_user_id")
  username          String
  followerCount     Int?       @map("follower_count")

  // OAuth tokens (encrypted at application level)
  accessToken       String?    @map("access_token")
  refreshToken      String?    @map("refresh_token")
  tokenExpiresAt    DateTime?  @map("token_expires_at")

  verifiedAt        DateTime?  @map("verified_at")
  lastSyncedAt      DateTime?  @map("last_synced_at")

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@unique([creatorId, platform])
  @@map("social_accounts")
}

enum Platform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

// OAuth Connection Management
model SocialConnection {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation("social_connections", fields: [userId], references: [id], onDelete: Cascade)

  platform          Platform
  platformUserId    String?   @map("platform_user_id")

  // OAuth tokens
  accessToken       String    @map("access_token")
  refreshToken      String?   @map("refresh_token")
  expiresAt         DateTime  @map("expires_at")
  scope             String?

  isActive          Boolean   @default(true) @map("is_active")
  connectedAt       DateTime  @default(now()) @map("connected_at")
  disconnectedAt    DateTime? @map("disconnected_at")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([userId, platform])
  @@map("social_connections")
}


// ============================================
// CAMPAIGNS
// ============================================

model Campaign {
  id                    String          @id @default(uuid())
  founderId             String          @map("founder_id")
  founder               User            @relation("founder_campaigns", fields: [founderId], references: [id], onDelete: Cascade)

  creatorId             String?         @map("creator_id")
  creator               User?           @relation("creator_campaigns", fields: [creatorId], references: [id])

  name                  String
  brandName             String?         @map("brand_name")
  description           String?
  status                CampaignStatus  @default(DRAFT)
  platform              Platform?

  // Budget
  totalBudget           Decimal         @map("total_budget") @db.Decimal(10, 2)
  baseFeeeBudget        Decimal         @map("base_fee_budget") @db.Decimal(10, 2)
  performanceBudget     Decimal         @map("performance_budget") @db.Decimal(10, 2)
  escrowBalance         Decimal         @default(0) @map("escrow_balance") @db.Decimal(10, 2)

  // Videos
  videosRequested       Int             @map("videos_requested")
  videosCompleted       Int             @default(0) @map("videos_completed")

  // Posting schedule
  postingFrequency      String?         @map("posting_frequency") // 'daily', 'every_other_day', etc.
  startDate             DateTime?       @map("start_date")
  deadline              DateTime?

  // Stripe
  stripePaymentIntentId String?         @map("stripe_payment_intent_id")

  // Brief data (stored as JSON for flexibility)
  briefData             Json?           @map("brief_data")

  // Final stats (populated after completion)
  finalViewsTotal       Int?            @map("final_views_total")
  totalPaidToCreator    Decimal?        @map("total_paid_to_creator") @db.Decimal(10, 2)
  totalRefundedToFounder Decimal?       @map("total_refunded_to_founder") @db.Decimal(10, 2)
  platformRevenue       Decimal?        @map("platform_revenue") @db.Decimal(10, 2)

  // Budget calculator options
  guaranteedSpend       Boolean         @default(false) @map("guaranteed_spend")
  targetViews           Int?            @map("target_views")

  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  completedAt           DateTime?       @map("completed_at")

  // Relations
  videos                Video[]
  payments              Payment[]
  licenses              License[]
  disputes              Dispute[]
  applications          Application[]

  conversations         Conversation[]
  assets                Asset[]
  variants              UGCVariant[]
  
  // Advanced Campaign System
  founderVideos         FounderVideo[]

  @@index([founderId, status])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  PENDING_CREATOR
  IN_PROGRESS
  IN_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// ============================================
// VIDEOS
// ============================================

model Video {
  id                    String          @id @default(uuid())
  campaignId            String          @map("campaign_id")
  campaign              Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creatorId             String?         @map("creator_id")
  creator               User?           @relation("creator_videos", fields: [creatorId], references: [id])

  // Content
  draftVideoUrl         String?         @map("draft_video_url")
  finalPostUrl          String?         @map("final_post_url")
  platform              Platform?
  platformVideoId       String?         @map("platform_video_id") // Extracted from URL

  // Status
  status                VideoStatus     @default(PENDING)

  // Dates
  submittedAt           DateTime?       @map("submitted_at")
  approvedAt            DateTime?       @map("approved_at")
  postedAt              DateTime?       @map("posted_at")
  lockedAt              DateTime?       @map("locked_at")

  // View tracking
  currentViewCount      Int             @default(0) @map("current_view_count")
  lockedViewCount       Int?            @map("locked_view_count")
  lastViewUpdate        DateTime?       @map("last_view_update")

  // Payments
  baseFeePaid           Boolean         @default(false) @map("base_fee_paid")
  baseFeeAmount         Decimal?        @map("base_fee_amount") @db.Decimal(10, 2)
  performanceBonusPaid  Boolean         @default(false) @map("performance_bonus_paid")
  performanceBonusAmount Decimal?       @map("performance_bonus_amount") @db.Decimal(10, 2)

  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relations
  viewSnapshots         ViewSnapshot[]
  payments              Payment[]
  revisions             Revision[]
  versions              VideoVersion[]
  licenses              License[]
  disputes              Dispute[]

  @@index([campaignId, status])
  @@index([postedAt])
  @@map("videos")
}

enum VideoStatus {
  PENDING
  DRAFT_SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  APPROVED
  POSTED
  LOCKED
}

// ============================================
// VIEW TRACKING
// ============================================

model ViewSnapshot {
  id          String    @id @default(uuid())
  videoId     String    @map("video_id")
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  viewCount   Int       @map("view_count")
  dataSource  String    @map("data_source") // 'tiktok_api', 'meta_api', 'manual'
  snapshotAt  DateTime  @default(now()) @map("snapshot_at")

  @@index([videoId, snapshotAt])
  @@map("view_snapshots")
}

// ============================================
// CONTENT REVISIONS
// ============================================

model Revision {
  id              String    @id @default(uuid())
  videoId         String    @map("video_id")
  video           Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  requestedBy     String    @map("requested_by") // User ID
  feedback        String
  priority        String?   // 'minor', 'significant', 'major'
  deadline        DateTime?
  iterationNumber Int       @default(1) @map("iteration_number")

  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("revisions")
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id              String        @id @default(uuid())
  campaignId      String?       @map("campaign_id")
  campaign        Campaign?     @relation(fields: [campaignId], references: [id])

  videoId         String?       @map("video_id")
  video           Video?        @relation(fields: [videoId], references: [id])

  recipientId     String        @map("recipient_id")
  recipient       User          @relation(fields: [recipientId], references: [id])

  amount          Decimal       @db.Decimal(10, 2)
  type            PaymentType
  status          PaymentStatus @default(PENDING)
  description     String?

  // Stripe references
  stripeTransferId  String?     @map("stripe_transfer_id")
  stripeRefundId    String?     @map("stripe_refund_id")

  // Additional metadata
  metadata        Json?
  failureReason   String?       @map("failure_reason")

  createdAt       DateTime      @default(now()) @map("created_at")
  processedAt     DateTime?     @map("processed_at")

  @@index([campaignId, type, status])
  @@map("payments")
}

enum PaymentType {
  BASE_FEE
  PERFORMANCE_BONUS
  REFUND
  REVENUE
  PAYOUT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================
// SETTLEMENTS
// ============================================

model Settlement {
  id                      String    @id @default(uuid())
  videoId                 String    @unique @map("video_id")
  campaignId              String    @map("campaign_id")

  lockedViews             Int       @map("locked_views")
  creatorPerformanceBonus Decimal   @map("creator_performance_bonus") @db.Decimal(10, 2)
  nalaRevenue             Decimal   @map("nala_revenue") @db.Decimal(10, 2)
  founderRefund           Decimal   @map("founder_refund") @db.Decimal(10, 2)

  settledAt               DateTime  @default(now()) @map("settled_at")

  @@map("settlements")
}

// ============================================
// LICENSES
// ============================================

model License {
  id              String    @id @default(uuid())
  campaignId      String    @map("campaign_id")
  campaign        Campaign  @relation(fields: [campaignId], references: [id])

  videoId         String    @map("video_id")
  video           Video     @relation(fields: [videoId], references: [id])

  creatorId       String    @map("creator_id")
  creator         User      @relation("creator_licenses", fields: [creatorId], references: [id])

  founderId       String    @map("founder_id")
  founder         User      @relation("founder_licenses", fields: [founderId], references: [id])

  licenseNumber   String    @unique @map("license_number")
  pdfUrl          String?   @map("pdf_url")

  granteeId       String?   @map("grantee_id")
  grantee         User?     @relation("LicenseGrantee", fields: [granteeId], references: [id])

  grantedAt       DateTime  @default(now()) @map("granted_at")

  @@map("licenses")
}

// ============================================
// REVENUE TRACKING
// ============================================

model Revenue {
  id          String    @id @default(uuid())
  campaignId  String    @map("campaign_id")
  videoId     String?   @map("video_id")

  amount      Decimal   @db.Decimal(10, 2)
  type        String    // 'markup', 'subscription', etc.
  viewsCount  Int?      @map("views_count")

  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([campaignId])
  @@map("revenue")
}

// ============================================
// EMAIL VERIFICATION TOKENS
// ============================================

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      TokenType // 'email_verification', 'password_reset'
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("verification_tokens")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ============================================
// SCHEDULED POSTS
// ============================================

model ScheduledPost {
  id                String           @id @default(uuid())
  videoId           String           @map("video_id")
  creatorId         String           @map("creator_id")
  campaignId        String           @map("campaign_id")

  platform          Platform
  scheduledFor      DateTime         @map("scheduled_for")
  timezone          String           @default("America/New_York")

  // Content
  caption           String?
  hashtags          String?
  videoUrl          String           @map("video_url")
  thumbnailUrl      String?          @map("thumbnail_url")

  // Status
  status            ScheduledPostStatus @default(PENDING)
  publishedAt       DateTime?        @map("published_at")
  platformPostId    String?          @map("platform_post_id") // ID from social platform
  platformPostUrl   String?          @map("platform_post_url")

  // Error tracking
  attempts          Int              @default(0)
  lastAttemptAt     DateTime?        @map("last_attempt_at")
  errorMessage      String?          @map("error_message")

  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([scheduledFor, status])
  @@index([creatorId, status])
  @@map("scheduled_posts")
}

enum ScheduledPostStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

// ============================================
// VIDEO SUBMISSIONS (Watermarked)
// ============================================

model VideoSubmission {
  id                  String    @id @default(uuid())
  videoId             String    @map("video_id")
  campaignId          String    @map("campaign_id")
  creatorId           String    @map("creator_id")

  // Original file
  originalUrl         String    @map("original_url")
  originalFilename    String    @map("original_filename")
  fileSize            Int       @map("file_size") // in bytes
  duration            Int?      // in seconds
  resolution          String?   // e.g., "1920x1080"

  // Watermarked version (for preview)
  watermarkedUrl      String    @map("watermarked_url")
  watermarkText       String    @default("NALA - PENDING APPROVAL") @map("watermark_text")

  // Thumbnail
  thumbnailUrl        String?   @map("thumbnail_url")

  // Processing status
  processingStatus    ProcessingStatus @default(PENDING) @map("processing_status")
  processingError     String?   @map("processing_error")

  // Submission metadata
  submissionNotes     String?   @map("submission_notes")
  version             Int       @default(1) // For revision tracking

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([videoId])
  @@index([creatorId])
  @@map("video_submissions")
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// AI GENERATED BRIEFS
// ============================================

model AIBrief {
  id              String    @id @default(uuid())
  campaignId      String?   @map("campaign_id")
  founderId       String    @map("founder_id")

  // Input parameters
  productName     String    @map("product_name")
  productDescription String @map("product_description")
  targetAudience  String    @map("target_audience")
  videoStyle      String?   @map("video_style") // 'tutorial', 'testimonial', 'unboxing', etc.
  keyFeatures     String[]  @map("key_features")
  tone            String?   // 'professional', 'casual', 'energetic', etc.

  // AI Generated content
  generatedScript String?   @map("generated_script")
  talkingPoints   String[]  @map("talking_points")
  hookIdeas       String[]  @map("hook_ideas")
  hashtagSuggestions String[] @map("hashtag_suggestions")
  callToAction    String?   @map("call_to_action")

  // Metadata
  model           String    @default("gpt-4") // AI model used
  tokensUsed      Int?      @map("tokens_used")

  // Status
  used            Boolean   @default(false) // Whether it was used in a campaign

  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([founderId])
  @@map("ai_briefs")
}

// ============================================
// APPLICATIONS
// ============================================

model Application {
  id          String    @id @default(uuid())
  campaignId  String    @map("campaign_id")
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  creatorId   String    @map("creator_id")
  creator     User      @relation("creator_applications", fields: [creatorId], references: [id], onDelete: Cascade)

  message     String?
  portfolioLinks String[] @map("portfolio_links")
  status      ApplicationStatus @default(PENDING)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([campaignId, creatorId])
  @@map("applications")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ============================================
// DISPUTES
// ============================================

model Dispute {
  id          String    @id @default(uuid())
  campaignId  String    @map("campaign_id")
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  videoId     String?   @map("video_id")
  video       Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  
  initiatorId String    @map("initiator_id") // Who started the dispute
  initiator   User      @relation("dispute_initiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  
  respondentId String   @map("respondent_id") // Who is being disputed against
  respondent   User     @relation("dispute_respondent", fields: [respondentId], references: [id], onDelete: Cascade)
  
  category    DisputeCategory
  description String
  status      DisputeStatus @default(PENDING)
  resolution  String?   // Admin notes on resolution
  resolvedAt  DateTime? @map("resolved_at")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  messages    DisputeMessage[]
  evidence    DisputeEvidence[]

  @@map("disputes")
}

model DisputeMessage {
  id          String    @id @default(uuid())
  disputeId   String    @map("dispute_id")
  dispute     Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  
  senderId    String    @map("sender_id")
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content     String
  isInternal  Boolean   @default(false) @map("is_internal") // If true, only visible to admins
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@index([disputeId])
  @@map("dispute_messages")
}

model DisputeEvidence {
  id          String    @id @default(uuid())
  disputeId   String    @map("dispute_id")
  dispute     Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  
  uploaderId  String    @map("uploader_id")
  uploader    User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  
  fileUrl     String    @map("file_url")
  fileType    String    @map("file_type") // IMAGE, VIDEO, PDF
  description String?
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@index([disputeId])
  @@map("dispute_evidence")
}

enum DisputeCategory {
  VIEW_COUNT_DISCREPANCY
  CONTENT_QUALITY
  POSTING_VIOLATION
  PAYMENT_ISSUE
  OTHER
}

enum DisputeStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean   @default(false) @map("is_read")
  
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  SYSTEM
  CAMPAIGN_INVITE
  APPLICATION_UPDATE
  VIDEO_STATUS
  PAYMENT
  DISPUTE
  FORMAT_ASSIGNED
  AB_TEST_COMPLETED
  GOAL_MILESTONE
  FOUNDER_VIDEO_POSTED
  PERFORMANCE_ALERT
}

// ============================================
// ROI CALCULATOR
// ============================================

model CalculatorScenario {
  id          String    @id @default(uuid())
  ownerId     String    @map("owner_id")
  // No relation to User to allow anonymous/demo usage if needed, 
  // or strictly enforce it. Plan said "ownerId: String (User relation)".
  // Let's make it optional for demo mode, or strictly relational if auth is required.
  // The plan implies auth for saving. Let's make it a relation.
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  campaignId  String?   @map("campaign_id")
  // Optional relation to Campaign
  // campaign    Campaign? @relation(fields: [campaignId], references: [id]) 
  // Keeping it loose for now to avoid circular dependency issues if not strictly needed, 
  // but relation is better for integrity. Let's add it if Campaign model is available.
  // Campaign model is available.
  
  name        String
  inputs      Json      // Stores budget, videos, rates, etc.
  results     Json      // Stores projections, summary stats
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("calculator_scenarios")
}

model AdminUser {
  id                      String         @id @default(uuid())
  userId                  String         @unique @map("user_id")
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  adminLevel              AdminLevel     @default(JUNIOR) @map("admin_level")
  permissions             Json           // {creator_verify, dispute_resolve, payment_override, etc}
  assignedQueue           AdminQueue?    @map("assigned_queue")
  maxManualOverrideAmount Decimal?       @map("max_manual_override_amount") @db.Decimal(12, 2)
  
  active                  Boolean        @default(true)
  twoFactorEnabled        Boolean        @default(false) @map("two_factor_enabled")
  twoFactorSecret         String?        @map("two_factor_secret")
  
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  
  // Relations
  auditLogs               AdminAuditLog[]
  emailBroadcasts         EmailBroadcast[]
  
  @@index([adminLevel])
  @@index([assignedQueue])
  @@map("admin_users")
}

enum AdminLevel {
  JUNIOR
  SENIOR
  MANAGER
  DIRECTOR
}

enum AdminQueue {
  CREATOR_KYC
  DISPUTES
  CAMPAIGNS
  SUPPORT
  COMPLIANCE
}

model AdminAuditLog {
  id           String    @id @default(uuid())
  adminId      String    @map("admin_id")
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  actionType   String    @map("action_type") // CREATOR_VERIFY, CREATOR_BAN, etc
  resourceType String?   @map("resource_type") // CREATOR, FOUNDER, CAMPAIGN, DISPUTE
  resourceId   String?   @map("resource_id")
  
  details      Json?     // {reason, amount, before_state, after_state, etc}
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  
  createdAt    DateTime  @default(now()) @map("created_at")
  
  @@index([adminId])
  @@index([actionType])
  @@index([resourceType])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model AdminDashboardMetric {
  id           String    @id @default(uuid())
  metricType   String    @map("metric_type") // gmv, revenue, payouts, etc
  metricValue  Json      @map("metric_value")
  dateRange    String    @default("TODAY") @map("date_range") // TODAY, WEEK, MONTH, YEAR
  
  calculatedAt DateTime  @default(now()) @map("calculated_at")
  expiresAt    DateTime? @map("expires_at") // Cache expiry
  
  @@unique([metricType, dateRange])
  @@index([metricType])
  @@index([expiresAt])
  @@map("admin_dashboard_metrics")
}

model EmailBroadcast {
  id             String    @id @default(uuid())
  adminId        String    @map("admin_id")
  admin          AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  recipientType  String    @map("recipient_type") // ALL_CREATORS, ALL_FOUNDERS, CUSTOM_LIST
  recipientIds   String[]  @map("recipient_ids") // For CUSTOM_LIST
  
  subject        String
  bodyHtml       String    @map("body_html")
  
  scheduledFor   DateTime? @map("scheduled_for")
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  sentCount      Int       @default(0) @map("sent_count")
  
  createdAt      DateTime  @default(now()) @map("created_at")
  sentAt         DateTime? @map("sent_at")
  
  @@index([adminId])
  @@index([status])
  @@index([scheduledFor])
  @@map("email_broadcasts")
}


// ============================================
// TRENDING VIDEO FORMATS
// ============================================

model VideoFormat {
  id                  String    @id @default(uuid())
  name                String    @map("format_name")
  description         String
  platforms           Platform[]
  
  // Structure & Content
  optimalLengthMin    Int       @map("optimal_length_min")
  optimalLengthMax    Int       @map("optimal_length_max")
  tone                String    // CASUAL, PROFESSIONAL, etc.
  categories          String[]  // PRODUCT_DEMO, TUTORIAL, etc.
  structure           Json      // {phase_1, phase_2...}
  bestPractices       String[]  @map("best_practices")
  
  // Stats
  firstUsedDate       DateTime  @map("first_used_date")
  totalAdopters       Int       @default(0) @map("total_adopters")
  adoptionTrend       String    @default("STABLE") @map("adoption_trend") // VIRAL, GROWING, STABLE, DECLINING
  avgViews            Int       @default(0) @map("avg_views")
  viewRange           Json?     @map("view_range") // {min, max, median}
  avgEngagementRate   Decimal?  @map("avg_engagement_rate") @db.Decimal(5, 2)
  successRate50k      Decimal?  @map("success_rate_50k_views") @db.Decimal(5, 2)
  estimatedAvgEarnings Decimal? @map("estimated_avg_earnings") @db.Decimal(10, 2)
  trendMomentum       Decimal?  @map("trend_momentum") @db.Decimal(5, 2)
  
  isTrending          Boolean   @default(false) @map("is_trending")
  
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  savedByCreators     CreatorFormatLibrary[]
  recommendations     FormatRecommendation[]

  @@map("video_formats")
}

model CreatorFormatLibrary {
  id                  String    @id @default(uuid())
  creatorId           String    @map("creator_id")
  creator             User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  formatId            String    @map("format_id")
  format              VideoFormat @relation(fields: [formatId], references: [id], onDelete: Cascade)
  
  savedAt             DateTime  @default(now()) @map("saved_at")
  customNotes         String?   @map("custom_notes")
  usageCount          Int       @default(0) @map("usage_count")
  
  @@unique([creatorId, formatId])
  @@map("creator_format_library")
}

model FormatRecommendation {
  id                  String    @id @default(uuid())
  creatorId           String    @map("creator_id")
  creator             User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  formatId            String    @map("format_id")
  format              VideoFormat @relation(fields: [formatId], references: [id], onDelete: Cascade)
  
  compatibilityScore  Decimal   @map("compatibility_score") @db.Decimal(5, 2)
  reason              String?
  estEarningsImpact   Decimal?  @map("estimated_earnings_impact") @db.Decimal(10, 2)
  
  createdAt           DateTime  @default(now()) @map("created_at")
  dismissed           Boolean   @default(false)

  @@index([creatorId])
  @@map("format_recommendations")
}

// ============================================
// MESSAGING & CONVERSATIONS (Phase 4)
// ============================================

model Conversation {
  id            String                    @id @default(uuid())
  campaignId    String?                   @map("campaign_id")
  campaign      Campaign?                 @relation(fields: [campaignId], references: [id])
  participants  ConversationParticipant[]
  messages      Message[]
  lastMessageAt DateTime?                 @map("last_message_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  
  @@index([campaignId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?    @map("last_read_at")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  
  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  attachments    Json?
  readBy         String[]     @default([]) @map("read_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ============================================
// ACTIVITY FEEDS (Phase 4)
// ============================================

model Activity {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType
  entityType  String       @map("entity_type")
  entityId    String       @map("entity_id")
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activities")
}

enum ActivityType {
  CAMPAIGN_CREATED
  VIDEO_SUBMITTED
  VIDEO_APPROVED
  PAYMENT_SENT
  APPLICATION_SUBMITTED
  MILESTONE_REACHED
}

// ============================================
// ASSET MANAGEMENT (Phase 5)
// ============================================

model Asset {
  id           String     @id @default(uuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AssetType
  name         String
  url          String
  thumbnailUrl String?    @map("thumbnail_url")
  fileSize     Int        @map("file_size")
  mimeType     String     @map("mime_type")
  metadata     Json?
  tags         String[]
  campaignId   String?    @map("campaign_id")
  campaign     Campaign?  @relation(fields: [campaignId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  
  @@index([userId, type])
  @@index([campaignId])
  @@map("assets")
}

enum AssetType {
  VIDEO
  IMAGE
  DOCUMENT
  AUDIO
  OTHER
}

model VideoVersion {
  id          String         @id @default(uuid())
  videoId     String         @map("video_id")
  video       Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  version     Int
  submittedBy String         @map("submitted_by")
  submitter   User           @relation("SubmittedVersions", fields: [submittedBy], references: [id])
  videoUrl    String         @map("video_url")
  thumbnailUrl String?       @map("thumbnail_url")
  notes       String?        @db.Text
  status      VersionStatus
  reviewedBy  String?        @map("reviewed_by")
  reviewer    User?          @relation("ReviewedVersions", fields: [reviewedBy], references: [id])
  reviewNotes String?        @map("review_notes") @db.Text
  submittedAt DateTime       @default(now()) @map("submitted_at")
  reviewedAt  DateTime?      @map("reviewed_at")
  
  @@index([videoId, version])
  @@index([status])
  @@map("video_versions")
}

enum VersionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// A/B TESTING & CONVERSION TRACKING
// ============================================

model UGCVariant {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorId   String   @map("creator_id")
  creator     User     @relation(fields: [creatorId], references: [id])
  
  label       String   // e.g. "Hook 1", "Testimonial"
  videoUrl    String?  @map("video_url")
  status      VariantStatus @default(DRAFT)
  
  // Tracking
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  trackingUrl String?  @map("tracking_url") // The unique link for this variant

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  metrics     VariantMetric[]

  @@map("ugc_variants")
  @@index([campaignId])
  @@index([creatorId])
}

enum VariantStatus {
  DRAFT
  PENDING_UPLOAD
  ACTIVE
  PAUSED
  COMPLETED
}

model VariantMetric {
  id          String     @id @default(uuid())
  variantId   String     @map("variant_id")
  variant     UGCVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  date        DateTime   @default(now()) // Daily snapshot
  
  views       Int        @default(0)
  clicks      Int        @default(0)
  conversions Int        @default(0)
  spend       Decimal    @default(0) @db.Decimal(10, 2)
  revenue     Decimal    @default(0) @db.Decimal(10, 2)
  
  ctr         Decimal    @default(0) @db.Decimal(5, 2) // Calculated
  conversionRate Decimal @default(0) @map("conversion_rate") @db.Decimal(5, 2) // Calculated
  roi         Decimal    @default(0) @db.Decimal(10, 2) // Calculated
  
  performanceScore Decimal @default(0) @map("performance_score") @db.Decimal(5, 2)

  @@map("variant_metrics")
  @@index([variantId, date])
}

// ============================================
// ADVANCED CAMPAIGN SYSTEM - FOUNDER VIDEOS
// ============================================

model FounderVideo {
  id                String          @id @default(uuid())
  campaignId        String          @map("campaign_id")
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  founderId         String          @map("founder_id")
  founder           User            @relation("founder_videos", fields: [founderId], references: [id])
  
  // Content
  videoUrl          String          @map("video_url")
  thumbnailUrl      String?         @map("thumbnail_url")
  caption           String?
  description       String?
  platform          Platform
  
  // Status
  status            FounderVideoStatus @default(DRAFT)
  isDraft           Boolean         @default(true) @map("is_draft")
  
  // Posting
  finalPostUrl      String?         @map("final_post_url")
  platformVideoId   String?         @map("platform_video_id")
  postedAt          DateTime?       @map("posted_at")
  
  // Tracking
  currentViewCount  Int             @default(0) @map("current_view_count")
  likes             Int             @default(0)
  comments          Int             @default(0)
  shares            Int             @default(0)
  completionRate    Decimal?        @map("completion_rate") @db.Decimal(5, 2)
  engagementRate    Decimal?        @map("engagement_rate") @db.Decimal(5, 2)
  watchTime         Int?            @map("watch_time")
  
  // Cost tracking
  costPerClick      Decimal?        @map("cost_per_click") @db.Decimal(10, 2)
  costPerAcquisition Decimal?       @map("cost_per_acquisition") @db.Decimal(10, 2)
  conversionRate    Decimal?        @map("conversion_rate") @db.Decimal(5, 2)
  
  // A/B Testing (Placeholder for Phase 1)
  abTestId          String?         @map("ab_test_id")
  variantLabel      String?         @map("variant_label")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  viewSnapshots     FounderVideoSnapshot[]
  
  @@index([campaignId, status])
  @@map("founder_videos")
}

enum FounderVideoStatus {
  DRAFT
  READY_TO_POST
  POSTED
  ARCHIVED
}

model FounderVideoSnapshot {
  id          String        @id @default(uuid())
  videoId     String        @map("video_id")
  video       FounderVideo  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  viewCount   Int           @map("view_count")
  likes       Int           @default(0)
  comments    Int           @default(0)
  shares      Int           @default(0)
  snapshotAt  DateTime      @default(now()) @map("snapshot_at")
  
  @@index([videoId, snapshotAt])
  @@map("founder_video_snapshots")
}
