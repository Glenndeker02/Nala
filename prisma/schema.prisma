generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  password                 String
  role                     Role                      @default(CREATOR)
  fullName                 String                    @map("full_name")
  companyName              String?                   @map("company_name")
  stripeCustomerId         String?                   @unique @map("stripe_customer_id")
  stripeAccountId          String?                   @unique @map("stripe_account_id")
  emailVerified            Boolean                   @default(false) @map("email_verified")
  emailVerifiedAt          DateTime?                 @map("email_verified_at")
  twoFactorEnabled         Boolean                   @default(false) @map("two_factor_enabled")
  twoFactorSecret          String?                   @map("two_factor_secret")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  lastLoginAt              DateTime?                 @map("last_login_at")
  suspendedUntil           DateTime?                 @map("suspended_until")
  suspensionReason         String?                   @map("suspension_reason")
  bannedReason             String?                   @map("banned_reason")
  founderTier              String?                   @map("founder_tier")
  companyIndustry          String?                   @map("company_industry")
  companyLogo              String?                   @map("company_logo")
  companySize              String?                   @map("company_size")
  companyWebsite           String?                   @map("company_website")
  language                 String?                   @default("en")
  phoneNumber              String?                   @map("phone_number")
  profilePictureUrl        String?                   @map("profile_picture_url")
  timezone                 String?                   @default("UTC")
  abTestVariants           ABTestVariant[]
  activities               Activity[]
  adminUser                AdminUser?
  applications             Application[]             @relation("creator_applications")
  assets                   Asset[]
  creatorCampaigns         Campaign[]                @relation("creator_campaigns")
  campaigns                Campaign[]                @relation("founder_campaigns")
  conversationParticipants ConversationParticipant[]
  savedFormats             CreatorFormatLibrary[]
  creatorProfile           CreatorProfile?
  disputeEvidence          DisputeEvidence[]
  disputeMessages          DisputeMessage[]
  initiatedDisputes        Dispute[]                 @relation("dispute_initiator")
  respondentDisputes       Dispute[]                 @relation("dispute_respondent")
  formatRecommendations    FormatRecommendation[]
  founderVideos            FounderVideo[]            @relation("founder_videos")
  instructionAudits        InstructionAudit[]        @relation("instruction_audit_actor")
  instructionTemplates     InstructionTemplate[]
  authoredInstructions     Instruction[]             @relation("instruction_author")
  creatorLicenses          License[]                 @relation("creator_licenses")
  licenses                 License[]                 @relation("founder_licenses")
  grantedLicenses          License[]                 @relation("LicenseGrantee")
  sentMessages             Message[]
  notificationPreferences  NotificationPreferences?
  notifications            Notification[]
  payments                 Payment[]
  socialAccounts           SocialAccount[]
  socialConnections        SocialConnection[]        @relation("social_connections")
  assignedVariants         UGCVariant[]
  reviewedVersions         VideoVersion[]            @relation("ReviewedVersions")
  submittedVersions        VideoVersion[]            @relation("SubmittedVersions")

  assignedVideos           Video[]                   @relation("creator_videos")
  creatorAssignments       CreatorCampaignAssignment[] @relation("creator_assignments")
  attributionCodes         AttributionCode[]         @relation("creator_attribution_codes")
  codeRedemptions          CodeRedemption[]          @relation("creator_redemptions")
  viewPayments             ViewPayment[]             @relation("creator_view_payments")
  payouts                  Payout[]                  @relation("creator_payouts")
  subscriptionEvents       SubscriptionEvent[]       @relation("creator_subscriptions")
  auditLogs                AuditLog[]

  @@map("users")
}

model CreatorProfile {
  id                        String             @id @default(uuid())
  userId                    String             @unique @map("user_id")
  bio                       String?
  categories                String[]
  baseFeeTiktok             Decimal            @default(75.00) @map("base_fee_tiktok") @db.Decimal(10, 2)
  baseFeeInstagram          Decimal            @default(75.00) @map("base_fee_instagram") @db.Decimal(10, 2)
  baseFeeFacebook           Decimal            @default(75.00) @map("base_fee_facebook") @db.Decimal(10, 2)
  portfolioVideos           Json?              @map("portfolio_videos")
  verificationStatus        VerificationStatus @default(PENDING) @map("verification_status")
  availabilityStatus        String?            @map("availability_status")
  responseTime              String?            @map("response_time")
  isOnboardingComplete      Boolean            @default(false) @map("is_onboarding_complete")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  adminNotes                String?            @map("admin_notes")
  avgRating                 Decimal            @default(0) @map("avg_rating") @db.Decimal(3, 2)
  avgResponseTimeHours      Int                @default(0) @map("avg_response_time_hours")
  campaignParticipationRate Decimal            @default(0) @map("campaign_participation_rate") @db.Decimal(5, 2)
  conversionRate            Decimal            @default(0) @map("conversion_rate") @db.Decimal(5, 2)
  disputeCount              Int                @default(0) @map("dispute_count")
  lastRankingUpdate         DateTime?          @map("last_ranking_update")
  rankingHistory            Json?              @map("ranking_history")
  rankingScore              Int                @default(50) @map("ranking_score")
  selectionRate             Decimal            @default(0) @map("selection_rate") @db.Decimal(5, 2)
  totalReviews              Int                @default(0) @map("total_reviews")
  videoQualityScore         Decimal            @default(0) @map("video_quality_score") @db.Decimal(5, 2)
  codePrefix                String?            @map("code_prefix")
  externalIdentifier        String?            @map("external_identifier")
  user                      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model SocialAccount {
  id             String    @id @default(uuid())
  creatorId      String    @map("creator_id")
  platform       Platform
  platformUserId String    @map("platform_user_id")
  username       String
  followerCount  Int?      @map("follower_count")
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  verifiedAt     DateTime? @map("verified_at")
  lastSyncedAt   DateTime? @map("last_synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  creator        User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
  @@map("social_accounts")
}

model SocialConnection {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  platform       Platform
  platformUserId String?   @map("platform_user_id")
  accessToken    String    @map("access_token")
  refreshToken   String?   @map("refresh_token")
  expiresAt      DateTime  @map("expires_at")
  scope          String?
  isActive       Boolean   @default(true) @map("is_active")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  disconnectedAt DateTime? @map("disconnected_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation("social_connections", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@map("social_connections")
}

model Campaign {
  id                     String                      @id @default(uuid())
  founderId              String                      @map("founder_id")
  creatorId              String?                     @map("creator_id")
  name                   String
  brandName              String?                     @map("brand_name")
  description            String?
  status                 CampaignStatus              @default(DRAFT)
  platform               Platform?
  totalBudget            Decimal                     @map("total_budget") @db.Decimal(10, 2)
  baseFeeBudget          Decimal                     @map("base_fee_budget") @db.Decimal(10, 2)
  performanceBudget      Decimal                     @map("performance_budget") @db.Decimal(10, 2)
  escrowBalance          Decimal                     @default(0) @map("escrow_balance") @db.Decimal(10, 2)
  videosRequested        Int                         @map("videos_requested")
  videosCompleted        Int                         @default(0) @map("videos_completed")
  postingFrequency       String?                     @map("posting_frequency")
  startDate              DateTime?                   @map("start_date")
  deadline               DateTime?
  stripePaymentIntentId  String?                     @map("stripe_payment_intent_id")
  briefData              Json?                       @map("brief_data")
  finalViewsTotal        Int?                        @map("final_views_total")
  totalPaidToCreator     Decimal?                    @map("total_paid_to_creator") @db.Decimal(10, 2)
  totalRefundedToFounder Decimal?                    @map("total_refunded_to_founder") @db.Decimal(10, 2)
  platformRevenue        Decimal?                    @map("platform_revenue") @db.Decimal(10, 2)
  guaranteedSpend        Boolean                     @default(false) @map("guaranteed_spend")
  targetViews            Int                         @default(0) @map("target_views")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  completedAt            DateTime?                   @map("completed_at")
  acceptedCreatorsCount  Int                         @default(0) @map("accepted_creators_count")
  eligibilityRules       Json?                       @map("eligibility_rules")
  notificationsSent      Boolean                     @default(false) @map("notifications_sent")
  baseFeePerVideo        Decimal                     @default(0) @map("base_fee_per_video") @db.Decimal(10, 2)
  performanceRate        Decimal                     @default(4.00) @map("performance_rate") @db.Decimal(10, 2)
  enableCreatorCodes     Boolean                     @default(false) @map("enable_creator_codes")
  creatorSubscriptionShare Decimal?                  @map("creator_subscription_share") @db.Decimal(5, 2)
  budgetReserved         Decimal                     @default(0) @map("budget_reserved") @db.Decimal(10, 2)
  webhookSecret          String?                     @map("webhook_secret")
  
  abTests                ABTest[]
  applications           Application[]
  assets                 Asset[]
  goals                  CampaignGoal[]
  creator                User?                       @relation("creator_campaigns", fields: [creatorId], references: [id])
  founder                User                        @relation("founder_campaigns", fields: [founderId], references: [id], onDelete: Cascade)
  conversations          Conversation[]
  disputes               Dispute[]
  founderVideos          FounderVideo[]
  instructions           Instruction[]
  licenses               License[]
  payments               Payment[]
  variants               UGCVariant[]
  videos                 Video[]
  assignments            CreatorCampaignAssignment[]
  attributionCodes       AttributionCode[]
  codeRedemptions        CodeRedemption[]
  viewPayments           ViewPayment[]
  payouts                Payout[]
  subscriptionEvents     SubscriptionEvent[]

  @@index([founderId, status])
  @@map("campaigns")
}

model CampaignGoal {
  id           String     @id @default(uuid())
  campaignId   String     @map("campaign_id")
  name         String
  description  String?
  type         GoalType
  targetValue  Decimal    @map("target_value") @db.Decimal(10, 2)
  currentValue Decimal    @default(0) @map("current_value") @db.Decimal(10, 2)
  deadline     DateTime?
  status       GoalStatus @default(IN_PROGRESS)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_goals")
}

model Video {
  id                     String            @id @default(uuid())
  campaignId             String            @map("campaign_id")
  creatorId              String?           @map("creator_id")
  draftVideoUrl          String?           @map("draft_video_url")
  finalPostUrl           String?           @map("final_post_url")
  platform               Platform?
  platformVideoId        String?           @map("platform_video_id")
  status                 VideoStatus       @default(PENDING)
  submittedAt            DateTime?         @map("submitted_at")
  approvedAt             DateTime?         @map("approved_at")
  postedAt               DateTime?         @map("posted_at")
  lockedAt               DateTime?         @map("locked_at")
  currentViewCount       Int               @default(0) @map("current_view_count")
  lockedViewCount        Int?              @map("locked_view_count")
  lastViewUpdate         DateTime?         @map("last_view_update")
  baseFeePaid            Boolean           @default(false) @map("base_fee_paid")
  baseFeeAmount          Decimal?          @map("base_fee_amount") @db.Decimal(10, 2)
  performanceBonusPaid   Boolean           @default(false) @map("performance_bonus_paid")
  performanceBonusAmount Decimal?          @map("performance_bonus_amount") @db.Decimal(10, 2)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  deadline               DateTime?
  founderComments        String?           @map("founder_comments")
  lastReviewedAt         DateTime?         @map("last_reviewed_at")
  performanceMetrics     Json?             @map("performance_metrics")
  revisionCount          Int               @default(0) @map("revision_count")
  revisionDeadline       DateTime?         @map("revision_deadline")
  title                  String?
  videoNumber            Int?              @map("video_number")
  abTestVariant          ABTestVariant?
  disputes               Dispute[]
  draftSubmissions       DraftSubmission[]
  licenses               License[]
  payments               Payment[]
  revisions              Revision[]
  versions               VideoVersion[]
  campaign               Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator                User?             @relation("creator_videos", fields: [creatorId], references: [id])
  viewSnapshots          ViewSnapshot[]

  @@index([campaignId, status])
  @@index([postedAt])
  @@map("videos")
}

model DraftSubmission {
  id                      String      @id @default(uuid())
  videoId                 String      @map("video_id")
  draftUrl                String      @map("draft_url")
  version                 Int         @default(1)
  status                  DraftStatus @default(PENDING_REVIEW)
  submittedAt             DateTime    @default(now()) @map("submitted_at")
  reviewedAt              DateTime?   @map("reviewed_at")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  instructionLinks        Json?       @map("instruction_links")
  instructionLibraryItems Json?       @map("instruction_library_items")
  video                   Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("draft_submissions")
}

model InstructionTemplate {
  id                   String          @id @default(uuid())
  founderId            String          @map("founder_id")
  name                 String
  content              String
  type                 InstructionType @default(GLOBAL)
  attachedLinks        Json?           @map("attached_links")
  attachedLibraryItems Json?           @map("attached_library_items")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  founder              User            @relation(fields: [founderId], references: [id], onDelete: Cascade)

  @@index([founderId])
  @@map("instruction_templates")
}

model ViewSnapshot {
  id         String   @id @default(uuid())
  videoId    String   @map("video_id")
  viewCount  Int      @map("view_count")
  dataSource String   @map("data_source")
  snapshotAt DateTime @default(now()) @map("snapshot_at")
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, snapshotAt])
  @@map("view_snapshots")
}

model Revision {
  id              String    @id @default(uuid())
  videoId         String    @map("video_id")
  requestedBy     String    @map("requested_by")
  feedback        String
  priority        String?
  deadline        DateTime?
  iterationNumber Int       @default(1) @map("iteration_number")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  video           Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("revisions")
}

model Payment {
  id               String        @id @default(uuid())
  campaignId       String?       @map("campaign_id")
  videoId          String?       @map("video_id")
  recipientId      String        @map("recipient_id")
  amount           Decimal       @db.Decimal(10, 2)
  type             PaymentType
  status           PaymentStatus @default(PENDING)
  description      String?
  stripeTransferId String?       @map("stripe_transfer_id")
  stripeRefundId   String?       @map("stripe_refund_id")
  metadata         Json?
  failureReason    String?       @map("failure_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  processedAt      DateTime?     @map("processed_at")
  campaign         Campaign?     @relation(fields: [campaignId], references: [id])
  recipient        User          @relation(fields: [recipientId], references: [id])
  video            Video?        @relation(fields: [videoId], references: [id])

  @@index([campaignId, type, status])
  @@map("payments")
}

model Settlement {
  id                      String   @id @default(uuid())
  videoId                 String   @unique @map("video_id")
  campaignId              String   @map("campaign_id")
  lockedViews             Int      @map("locked_views")
  creatorPerformanceBonus Decimal  @map("creator_performance_bonus") @db.Decimal(10, 2)
  nalaRevenue             Decimal  @map("nala_revenue") @db.Decimal(10, 2)
  founderRefund           Decimal  @map("founder_refund") @db.Decimal(10, 2)
  settledAt               DateTime @default(now()) @map("settled_at")

  @@map("settlements")
}

model License {
  id            String   @id @default(uuid())
  campaignId    String   @map("campaign_id")
  videoId       String   @map("video_id")
  creatorId     String   @map("creator_id")
  founderId     String   @map("founder_id")
  licenseNumber String   @unique @map("license_number")
  pdfUrl        String?  @map("pdf_url")
  granteeId     String?  @map("grantee_id")
  grantedAt     DateTime @default(now()) @map("granted_at")
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  creator       User     @relation("creator_licenses", fields: [creatorId], references: [id])
  founder       User     @relation("founder_licenses", fields: [founderId], references: [id])
  grantee       User?    @relation("LicenseGrantee", fields: [granteeId], references: [id])
  video         Video    @relation(fields: [videoId], references: [id])

  @@map("licenses")
}

model Revenue {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  videoId    String?  @map("video_id")
  amount     Decimal  @db.Decimal(10, 2)
  type       String
  viewsCount Int?     @map("views_count")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([campaignId])
  @@map("revenue")
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("verification_tokens")
}

model ScheduledPost {
  id              String              @id @default(uuid())
  videoId         String              @map("video_id")
  creatorId       String              @map("creator_id")
  campaignId      String              @map("campaign_id")
  platform        Platform
  scheduledFor    DateTime            @map("scheduled_for")
  timezone        String              @default("America/New_York")
  caption         String?
  hashtags        String?
  videoUrl        String              @map("video_url")
  thumbnailUrl    String?             @map("thumbnail_url")
  status          ScheduledPostStatus @default(PENDING)
  publishedAt     DateTime?           @map("published_at")
  platformPostId  String?             @map("platform_post_id")
  platformPostUrl String?             @map("platform_post_url")
  attempts        Int                 @default(0)
  lastAttemptAt   DateTime?           @map("last_attempt_at")
  errorMessage    String?             @map("error_message")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([scheduledFor, status])
  @@index([creatorId, status])
  @@map("scheduled_posts")
}

model VideoSubmission {
  id               String           @id @default(uuid())
  videoId          String           @map("video_id")
  campaignId       String           @map("campaign_id")
  creatorId        String           @map("creator_id")
  originalUrl      String           @map("original_url")
  originalFilename String           @map("original_filename")
  fileSize         Int              @map("file_size")
  duration         Int?
  resolution       String?
  watermarkedUrl   String           @map("watermarked_url")
  watermarkText    String           @default("NALA - PENDING APPROVAL") @map("watermark_text")
  thumbnailUrl     String?          @map("thumbnail_url")
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  processingError  String?          @map("processing_error")
  submissionNotes  String?          @map("submission_notes")
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([videoId])
  @@index([creatorId])
  @@map("video_submissions")
}

model AIBrief {
  id                 String   @id @default(uuid())
  campaignId         String?  @map("campaign_id")
  founderId          String   @map("founder_id")
  productName        String   @map("product_name")
  productDescription String   @map("product_description")
  targetAudience     String   @map("target_audience")
  videoStyle         String?  @map("video_style")
  keyFeatures        String[] @map("key_features")
  tone               String?
  generatedScript    String?  @map("generated_script")
  talkingPoints      String[] @map("talking_points")
  hookIdeas          String[] @map("hook_ideas")
  hashtagSuggestions String[] @map("hashtag_suggestions")
  callToAction       String?  @map("call_to_action")
  model              String   @default("gpt-4")
  tokensUsed         Int?     @map("tokens_used")
  used               Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([founderId])
  @@map("ai_briefs")
}

model Application {
  id                      String            @id @default(uuid())
  campaignId              String            @map("campaign_id")
  creatorId               String            @map("creator_id")
  message                 String?
  portfolioLinks          String[]          @map("portfolio_links")
  status                  ApplicationStatus @default(PENDING)
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  acceptanceDeadline      DateTime?         @map("acceptance_deadline")
  acceptanceInstructions  String?           @map("acceptance_instructions")
  acceptedAt              DateTime?         @map("accepted_at")
  assignedAt              DateTime?         @map("assigned_at")
  instructionDeadlines    Json?             @map("instruction_deadlines")
  instructionLibraryItems Json?             @map("instruction_library_items")
  instructionLinks        Json?             @map("instruction_links")
  overallInstructions     String?           @map("overall_instructions")
  rejectedAt              DateTime?         @map("rejected_at")
  rejectionReason         String?           @map("rejection_reason")
  videoInstructions       Json?             @map("video_instructions")
  campaign                Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator                 User              @relation("creator_applications", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
  @@map("applications")
}

model Instruction {
  id                    String             @id @default(uuid())
  campaignId            String             @map("campaign_id")
  text                  String
  attachedLibraryItemId String?            @map("attached_library_item_id")
  authorId              String             @map("author_id")
  appliesTo             String             @map("applies_to")
  status                InstructionStatus  @default(OPEN)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  auditLogs             InstructionAudit[]
  author                User               @relation("instruction_author", fields: [authorId], references: [id])
  campaign              Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("instructions")
}

model InstructionAudit {
  id            String      @id @default(uuid())
  instructionId String      @map("instruction_id")
  action        String
  actorId       String      @map("actor_id")
  changes       Json
  timestamp     DateTime    @default(now())
  actor         User        @relation("instruction_audit_actor", fields: [actorId], references: [id])
  instruction   Instruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)

  @@index([instructionId, timestamp])
  @@map("instruction_audits")
}

model Dispute {
  id           String            @id @default(uuid())
  campaignId   String            @map("campaign_id")
  videoId      String?           @map("video_id")
  initiatorId  String            @map("initiator_id")
  respondentId String            @map("respondent_id")
  category     DisputeCategory
  description  String
  status       DisputeStatus     @default(PENDING)
  resolution   String?
  resolvedAt   DateTime?         @map("resolved_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  evidence     DisputeEvidence[]
  messages     DisputeMessage[]
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  initiator    User              @relation("dispute_initiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  respondent   User              @relation("dispute_respondent", fields: [respondentId], references: [id], onDelete: Cascade)
  video        Video?            @relation(fields: [videoId], references: [id])

